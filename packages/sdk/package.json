{
  "name": "@provable-games/evm-starknet-address-registry",
  "version": "1.0.0",
  "description": "Framework-independent EVM\u2013Starknet address registry SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Provable-Games/evm-starknet-address-registry.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "viem": "2.56.8"
  }
}
